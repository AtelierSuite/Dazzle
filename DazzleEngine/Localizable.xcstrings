    "Error.UnwritablePart" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dazzle couldn’t write “%@”. The presentation wasn’t saved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”を書き込めませんでした。プレゼンテーションは保存されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 쓸 수 없습니다. 프레젠테이션이 저장되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入“%@”。演示文稿未存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法寫入「%@」。簡報未儲存。"
          }
        }
      }
    },
    "Error.VideoExport" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The video couldn’t be made."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオを作成できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오를 만들 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法制作视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法製作影片。"
          }
        }
      }
    },
    "Notice.Feature.Charts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charts are kept, and shown as placeholders."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラフは保持され、プレースホルダとして表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차트는 유지되며 자리 표시자로 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图表会保留，并显示为占位符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖表會保留，並顯示為預留位置。"
          }
        }
      }
    },
    "Notice.Feature.EmbeddedObjects" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Embedded objects are kept, but can’t be opened."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "埋め込みオブジェクトは保持されますが、開くことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포함된 개체는 유지되지만 열 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嵌入的对象会保留，但无法打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嵌入的物件會保留，但無法打開。"
          }
        }
      }
    },
    "Notice.Feature.Macros" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macros are kept in the file, but Dazzle never runs them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロはファイルに保持されますが、Dazzleが実行することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매크로는 파일에 유지되지만 Dazzle은 이를 실행하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宏会保留在文件中，但 Dazzle 不会运行它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巨集會保留在檔案中，但 Dazzle 不會執行它們。"
          }
        }
      }
    },
    "Notice.Feature.Media" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some videos or sounds are in formats that can’t be played here, or are linked to files that aren’t in the presentation. Their pictures are shown instead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のビデオやサウンドはここで再生できない形式であるか、プレゼンテーションに含まれていないファイルにリンクされています。代わりに画像が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 비디오 또는 사운드가 여기에서 재생할 수 없는 형식이거나 프레젠테이션에 포함되지 않은 파일에 연결되어 있습니다. 대신 해당 사진이 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分视频或声音的格式无法在此播放，或链接到不在演示文稿中的文件。将改为显示其图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分影片或聲音的格式無法在此播放，或連結至不在簡報中的檔案。將改為顯示其圖片。"
          }
        }
      }
    },
    "Notice.Feature.Transitions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slide transitions are kept, but slides appear without them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面切り替えは保持されますが、再生されません。"
