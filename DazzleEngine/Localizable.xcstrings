    "Error.KeynoteNotWritable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dazzle can’t save these changes into the Keynote presentation. Share a copy as PowerPoint to keep them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dazzleではこれらの変更をKeynoteプレゼンテーションに保存できません。変更を残すには、PowerPoint形式のコピーを共有してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dazzle은 이 변경 사항을 Keynote 프레젠테이션에 저장할 수 없습니다. 변경 사항을 유지하려면 PowerPoint 사본을 공유하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dazzle 无法将这些更改存储到 Keynote 演示文稿中。若要保留更改，请以 PowerPoint 格式共享副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dazzle 無法將這些變更儲存到 Keynote 簡報中。若要保留變更，請以 PowerPoint 格式分享副本。"
          }
        }
      }
    },
    "Error.NotAKeynotePresentation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file isn’t a Keynote presentation Dazzle can open."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはDazzleで開けるKeynoteプレゼンテーションではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일은 Dazzle에서 열 수 있는 Keynote 프레젠테이션이 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件不是 Dazzle 可以打开的 Keynote 演示文稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案不是 Dazzle 可以打開的 Keynote 簡報。"
          }
        }
      }
    },
