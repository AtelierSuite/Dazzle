        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전환 효과는 유지되지만 재생되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换效果会保留，但不会播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉場效果會保留，但不會播放。"
          }
        }
      }
    },
