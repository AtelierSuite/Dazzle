    "Web.Start.Intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a PowerPoint or Keynote presentation, or start a new one. Everything stays on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerPointやKeynoteのプレゼンテーションを開くか、新しいプレゼンテーションを作成します。データはすべてこのデバイスに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerPoint 또는 Keynote 프레젠테이션을 열거나 새 프레젠테이션을 시작하십시오. 모든 데이터는 이 기기에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 PowerPoint 或 Keynote 演示文稿，或新建演示文稿。所有内容都保留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 PowerPoint 或 Keynote 簡報，或新增簡報。所有內容都保留在此裝置上。"
          }
        }
      }
    },
