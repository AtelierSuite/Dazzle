    "Web.About.Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A presentation app that opens, edits and plays PowerPoint presentations, and opens Keynote presentations, entirely on this device. Dazzle works offline once it has loaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerPointのプレゼンテーションを開いて編集・再生でき、Keynoteのプレゼンテーションも開けるプレゼンテーションアプリです。すべてこのデバイス上で動作し、一度読み込めばオフラインでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PowerPoint 프레젠테이션을 열고 편집하고 재생하며, Keynote 프레젠테이션도 여는 프레젠테이션 앱입니다. 모든 작업이 이 기기에서 이루어지며, 한 번 불러오면 오프라인에서도 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可打开、编辑和播放 PowerPoint 演示文稿，也可打开 Keynote 演示文稿的演示应用。所有操作都在此设备上完成，载入一次后即可离线使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可打開、編輯和播放 PowerPoint 簡報，也可打開 Keynote 簡報的簡報 App。所有操作都在此裝置上完成，載入一次後即可離線使用。"
          }
        }
      }
    },
