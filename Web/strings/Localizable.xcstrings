    "Web.Drop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a presentation to open it, or a picture or movie to put it on the slide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンテーションをドロップして開くか、画像やムービーをドロップしてスライドに配置"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레젠테이션을 놓아서 열거나, 사진이나 동영상을 놓아서 슬라이드에 넣기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放演示文稿以打开，或拖放图片或影片以放到幻灯片上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放簡報以打開，或拖放圖片或影片以放到投影片上"
          }
        }
      }
    },
    "Web.Error.Engine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The presentation engine stopped. Your last autosaved copy is in Open Recent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンテーションエンジンが停止しました。最後に自動保存されたコピーは「最近使った項目を開く」にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레젠테이션 엔진이 중지되었습니다. 마지막으로 자동 저장된 사본은 ‘최근 항목 열기’에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示文稿引擎已停止。最近一次自动存储的副本在“打开最近使用”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡報引擎已停止。最近一次自動儲存的副本在「打開最近使用的檔案」中。"
          }
        }
      }
    },
    "Web.Error.Missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” can't be opened again from here. Open it with Open… instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”はここから再度開くことができません。「開く…」から開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(를) 여기에서 다시 열 수 없습니다. ‘열기…’로 여십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从这里再次打开“%@”。请改用“打开…”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從這裡再次打開「%@」。請改用「打開⋯」。"
          }
        }
      }
    },
    "Web.Error.Open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
