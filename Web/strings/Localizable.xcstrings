    "Web.Play.PopupBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audience window couldn’t open, so the slideshow plays here. Allow pop-up windows for this site to present with the presenter view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観客用ウインドウを開けなかったため、このウインドウで再生します。発表者ビューで発表するには、このサイトのポップアップウインドウを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "청중용 윈도우를 열 수 없어 여기에서 슬라이드 쇼를 재생합니다. 발표자 보기로 발표하려면 이 사이트의 팝업 윈도우를 허용하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开观众窗口，因此幻灯片放映在此播放。要使用演讲者视图演示，请允许此网站打开弹出式窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開觀眾視窗，因此在此播放投影片秀。若要以簡報者顯示畫面進行簡報，請允許此網站打開彈出式視窗。"
          }
        }
      }
    },
    "Web.Play.PresenterView": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play with Presenter View"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発表者ビューで再生"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발표자 보기로 재생"
