            "state": "translated",
            "value": "찾기 및 대치…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找并替换…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找與取代…"
          }
        }
      }
    },
